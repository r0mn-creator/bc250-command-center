#!/usr/bin/env bash
# Root-only helper for the BC-250 dashboard: GPU undervolt search.
# Thin wrapper around gpu-undervolt.py, filling in machine-specific paths
# from /etc/bc250-dashboard.conf. Mirrors bc250-dash-gpu-autooc.
set -euo pipefail

CONF_FILE="/etc/bc250-dashboard.conf"
[ -f "$CONF_FILE" ] || { echo "ERROR: $CONF_FILE not found - run install.sh first" >&2; exit 1; }
source "$CONF_FILE"

if [ "$(id -u)" != "0" ]; then
    echo "ERROR: must run as root" >&2
    exit 1
fi

if [ -z "${GOVERNOR_SERVICE:-}" ]; then
    echo "ERROR: no governor service was detected at install time" >&2
    exit 1
fi

exec python3 "${PREFIX}/gpu-undervolt.py" \
    --oberon-conf "${OBERON_CONF:-/etc/oberon-config.yaml}" \
    --governor-service "$GOVERNOR_SERVICE" \
    --graphics-verify-script "${PREFIX}/bc250-graphics-verify.sh" \
    "$@"
